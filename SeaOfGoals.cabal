cabal-version:      3.14
name:               SeaOfGoals
version:            0.1.0.0
-- synopsis:
-- description:
license:            GPL-3.0-or-later
license-file:       LICENSE
author:             Erchius
maintainer:         zeyue_jia@u.nus.edu
-- copyright:
category:           Agent
build-type:         Simple
extra-doc-files:    CHANGELOG.md
extra-source-files:
    lib/Agent/SeaOfGoals/Prompts/*.txt

common warnings
    ghc-options: -Wall
    default-extensions:
        OverloadedStrings
        ScopedTypeVariables
        TemplateHaskell

library
    import:           warnings
    exposed-modules:
        Agent.LLM.Transport
        Agent.SeaOfGoals.Agentic
        Agent.SeaOfGoals.Compiler
        Agent.SeaOfGoals.ExperimentRunner
        Agent.SeaOfGoals.Harness
        Agent.SeaOfGoals.LLM
        Agent.SeaOfGoals.LLM.Backends.GPT
        Agent.SeaOfGoals.LLM.Backends.Gemini
        Agent.SeaOfGoals.PromptTemplate
        Agent.SeaOfGoals.Talks
        Agent.SeaOfGoals.Tools
        Agent.SeaOfGoals.Trace
        Agent.SeaOfGoals.Workflow
    -- other-modules:
    -- other-extensions:
    build-depends:
        aeson,
        aeson-qq,
        base ^>=4.21.0.0,
        bytestring,
        case-insensitive,
        http-client,
        http-client-tls,
        http-types,
        containers,
        directory,
        filepath,
        process,
        template-haskell,
        text,
        time
    hs-source-dirs:   lib
    default-language: GHC2024

executable SeaOfGoals-compiler
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.21.0.0,
        SeaOfGoals
    hs-source-dirs:   compiler
    default-language: GHC2024

test-suite SeaOfGoals-agent-runner
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    build-depends:
        base ^>=4.21.0.0,
        SeaOfGoals
    hs-source-dirs:   test-suite/agent-runner
    default-language: GHC2024

test-suite SeaOfGoals-test
    import:           warnings
    default-language: GHC2024
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        aeson,
        aeson-qq,
        base ^>=4.21.0.0,
        containers,
        SeaOfGoals,
        text
