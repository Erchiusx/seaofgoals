cabal-version:      3.14
name:               SeaOfGoals
version:            0.1.0.0
-- synopsis:
-- description:
license:            GPL-3.0-or-later
license-file:       LICENSE
author:             Erchius
maintainer:         zeyue_jia@u.nus.edu
-- copyright:
category:           Agent
build-type:         Simple
extra-doc-files:    CHANGELOG.md
extra-source-files:
    lib/Agent/SeaOfGoals/Prompts/*.txt
    pi/*.mjs
    seaofgoals.config.json

flag fuse
    description: Build the libfuse3 workspace mount backend.
    default:     False
    manual:      True

common warnings
    ghc-options: -Wall
    default-extensions:
        OverloadedStrings
        CPP
        ImportQualifiedPost
        ScopedTypeVariables
        TemplateHaskell
        TypeFamilies

library
    import:           warnings
    exposed-modules:
        Agent.LLM.Transport
        Agent.SeaOfGoals.Config
        Agent.SeaOfGoals.CodexProcess
        Agent.SeaOfGoals.Compile.Bootstrap
        Agent.SeaOfGoals.Compile.Compiler
        Agent.SeaOfGoals.Compile.PromptTemplate
        Agent.SeaOfGoals.ExperimentRunner
        Agent.SeaOfGoals.GoalContextPreload
        Agent.SeaOfGoals.HistoryHandoff
        Agent.SeaOfGoals.Harness
        Agent.SeaOfGoals.LLM
        Agent.SeaOfGoals.LLM.Backends.GPT
        Agent.SeaOfGoals.LLM.Backends.Gemini
        Agent.SeaOfGoals.PiProcess
        Agent.SeaOfGoals.PredictedActions
        Agent.SeaOfGoals.Scheduling.Agentic
        Agent.SeaOfGoals.Scheduling.Compiled
        Agent.SeaOfGoals.Scheduling.ConcurrentChase
        Agent.SeaOfGoals.Scheduling.Graph
        Agent.SeaOfGoals.Scheduling.GraphChase
        Agent.SeaOfGoals.Scheduling.MergeScheduler
        Agent.SeaOfGoals.Scheduling.PlannerResolution
        Agent.SeaOfGoals.Scheduling.Replan
        Agent.SeaOfGoals.Scheduling.SerialScheduler
        Agent.SeaOfGoals.Scheduling.SpeculativeChase
        Agent.SeaOfGoals.Talks
        Agent.SeaOfGoals.Tools
        Agent.SeaOfGoals.Trace
        Agent.SeaOfGoals.Workspace.Bwrap.Command
        Agent.SeaOfGoals.Workspace.Bwrap.Profile
        Agent.SeaOfGoals.Workspace.Bwrap.ToolBinding
        Agent.SeaOfGoals.Workspace.Bwrap.Visibility
        Agent.SeaOfGoals.Workspace.Containerd.Command
        Agent.SeaOfGoals.Workspace.Backend
        Agent.SeaOfGoals.Workspace.ConflictPolicy
        Agent.SeaOfGoals.Workspace.Effects
        Agent.SeaOfGoals.Workspace.Fuse.Merge
        Agent.SeaOfGoals.Workspace.Fuse.Store
        Agent.SeaOfGoals.Workspace.ProcessExec
        Agent.SeaOfGoals.Workspace.Sandbox.Bwrap
        Agent.SeaOfGoals.Workspace.Sandbox.Containerd
        Agent.SeaOfGoals.Workspace.Sandbox.Process
        Agent.SeaOfGoals.Workspace.Sandbox
        Agent.SeaOfGoals.Workspace.ToolRunner.Sandboxed
        Agent.SeaOfGoals.Workspace.ToolRunner
        Agent.SeaOfGoals.Workflow
    -- other-modules:
    -- other-extensions:
    build-depends:
        aeson,
        aeson-qq,
        async,
        base ^>=4.21.0.0,
        bytestring,
        case-insensitive,
        http-client,
        http-client-tls,
        http-types,
        containers,
        directory,
        filepath,
        process,
        template-haskell,
        text,
        time,
        unix,
        vector
    if flag(fuse)
        exposed-modules:
            Agent.SeaOfGoals.Workspace.Fuse.Mount
        cpp-options:
            -DSOG_FUSE
        build-depends:
            libfuse3 >=0.2 && <0.3
    hs-source-dirs:   lib
    default-language: GHC2024

executable SeaOfGoals-compiler
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.21.0.0,
        SeaOfGoals
    hs-source-dirs:   compiler
    default-language: GHC2024

executable SeaOfGoals-compiler-bootstrap
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.21.0.0,
        SeaOfGoals
    hs-source-dirs:   compiler-bootstrap
    default-language: GHC2024

executable SeaOfGoals-fuse-mount-smoke
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   smoke/fuse-mount
    default-language: GHC2024
    ghc-options:      -threaded
    if !flag(fuse)
        buildable: False
    else
        build-depends:
            base ^>=4.21.0.0,
            bytestring,
            directory,
            filepath,
            process,
            SeaOfGoals,
            unix

executable SeaOfGoals-containerd-smoke
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   smoke/containerd
    default-language: GHC2024
    build-depends:
        base ^>=4.21.0.0,
        bytestring,
        directory,
        filepath,
        SeaOfGoals,
        text

executable SeaOfGoals-bwrap-smoke
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   smoke/bwrap
    default-language: GHC2024
    build-depends:
        base ^>=4.21.0.0,
        bytestring,
        directory,
        filepath,
        SeaOfGoals,
        text,
        time

test-suite SeaOfGoals-agent-runner
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    ghc-options:      -threaded
    build-depends:
        base ^>=4.21.0.0,
        SeaOfGoals
    hs-source-dirs:   test-suite/agent-runner
    default-language: GHC2024

test-suite SeaOfGoals-pi-process
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test-suite/pi-process
    default-language: GHC2024
    build-depends:
        base ^>=4.21.0.0,
        directory,
        filepath,
        SeaOfGoals,
        text,
        unix

test-suite SeaOfGoals-test
    import:           warnings
    default-language: GHC2024
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        aeson,
        aeson-qq,
        base ^>=4.21.0.0,
        bytestring,
        containers,
        directory,
        filepath,
        SeaOfGoals,
        text,
        time

test-suite SeaOfGoals-fuse-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test-fuse
    default-language: GHC2024
    ghc-options:      -threaded
    if !flag(fuse)
        buildable: False
    else
        build-depends:
            base ^>=4.21.0.0,
            bytestring,
            directory,
            filepath,
            libfuse3,
            SeaOfGoals
